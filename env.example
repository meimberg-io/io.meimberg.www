# Environment Variables Example
# Copy this to .env for local development

# Application
NODE_ENV=development
APP_PORT=3000

# Next.js Public Variables (accessible in browser)
NEXT_PUBLIC_STORYBLOK_TOKEN=your-storyblok-token-here
NEXT_PUBLIC_STORYBOOK_DISABLECACHING=false
NEXT_PUBLIC_MATOMO_TRACKER=false

# Server-side only variables (not accessible in browser)
NEXT_PUBLIC_STORYBLOK_EDITOR_SECRET=your-editor-secret-here
REVALIDATE_SECRET=your-revalidate-secret-here
# Liefert ALLE Seiten aus dem Entwurfsstand — nur für die lokale Entwicklung,
# damit die Preview über Klicks hinweg erhalten bleibt. Auf einem öffentlichen
# Server niemals setzen: unveröffentlichte Inhalte wären für jeden sichtbar.
# Im Storyblok Visual Editor braucht es die Variable nicht, dort trägt der
# ?secret=-Parameter die Preview.
STORYBLOK_PREVIEW=
# Newsletter (Buttondown): API key from https://buttondown.com/settings/api – used only in API route
BUTTONDOWN_API_KEY=

# Development specific
DEBUG=true
LOG_LEVEL=debug

