

# Leafcutter OS, Leafcutter STRICT and the meimberg colony resolve to their registries; no token here, ever:
# each machine keeps its read tokens in its own ~/.npmrc.
@leafcutter-os:registry=https://packages.leafcutteros.ai
@leafcutter-governance:registry=https://packages.leafcutteros.ai
@leafcutter-strict:registry=https://packages.leafcutteros.ai
@leafcutter-library:registry=https://packages.leafcutteros.ai
@meimberg-io:registry=https://npm.pkg.github.com
